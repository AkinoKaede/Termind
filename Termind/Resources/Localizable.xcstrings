        }
      }
    },
    "`rsync --delete` removes files missing from the source." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`rsync --delete`会删除源中不存在的文件。"
