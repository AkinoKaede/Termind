      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@`会更改系统或文件状态。"
          }
        }
      }
    },
    "`%@` is not a recognised read-only command." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@`不是可识别的只读命令。"
