        }
      }
    },
    "`crontab -r` erases the crontab with no prompt." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`crontab -r`会直接清空crontab且不作确认。"
          }
        }
      }
    },
    "`docker system prune` reclaims and deletes broadly." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`docker system prune`会大范围回收并删除数据。"
          }
        }
      }
    },
    "`find -delete` removes every match." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`find -delete`会删除每个匹配项。"
          }
        }
      }
    },
    "`find -exec` runs a command per match." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`find -exec`会为每个匹配项运行命令。"
          }
        }
      }
    },
    "`git clean` deletes untracked files." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`git clean`会删除未跟踪的文件。"
          }
        }
      }
    },
    "`git reset --hard` discards uncommitted work." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`git reset --hard`会丢弃未提交的更改。"
