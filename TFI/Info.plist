<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.akinokaede.termind.workspace</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>termind</string>
			</array>
		</dict>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>Authenticate to use your SSH keys.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>TermindCloudKitEnvironment</key>
	<string>$(ICLOUD_CONTAINER_ENVIRONMENT)</string>
	<key>TermindKeychainAccessGroup</key>
	<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
