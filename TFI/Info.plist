<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>TermindRevenueCatAPIKey</key>
	<string>$(REVENUECAT_API_KEY)</string>
	<key>TermindRevenueCatEntitlementID</key>
	<string>$(REVENUECAT_ENTITLEMENT_ID)</string>
	<key>FirebaseCrashlyticsCollectionEnabled</key>
	<false/>
	<key>FirebaseDataCollectionDefaultEnabled</key>
	<false/>
	<key>FIREBASE_ANALYTICS_COLLECTION_DEACTIVATED</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.akinokaede.termind.workspace</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>termind</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.akinokaede.termind.remote-connections</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ssh</string>
				<string>sftp</string>
				<string>telnet</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.akinokaede.termind.open-workspace</string>
	</array>
	<key>TermindCloudKitEnvironment</key>
	<string>$(ICLOUD_CONTAINER_ENVIRONMENT)</string>
	<key>TermindKeychainAccessGroup</key>
	<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>network</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>QUICK_ACTION_CONNECT_TITLE</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.akinokaede.termind.quickAction.connect</string>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Termind SFTP Items</string>
			<key>UTTypeIdentifier</key>
			<string>com.akinokaede.termind.sftp-items</string>
		</dict>
	</array>
</dict>
</plist>
