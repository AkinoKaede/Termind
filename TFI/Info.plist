<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.akinokaede.termind.workspace</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>termind</string>
			</array>
		</dict>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>Authenticate to use your SSH keys.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>TermindCloudKitEnvironment</key>
	<string>$(ICLOUD_CONTAINER_ENVIRONMENT)</string>
	<key>TermindKeychainAccessGroup</key>
	<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Termind uses the microphone to transcribe speech into your chat draft.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Termind uses Apple Speech Recognition to turn your recording into text. Depending on system settings and language support, Apple may process the audio online.</string>
	<key>NSCameraUsageDescription</key>
	<string>Termind uses the camera to attach photos to your chat.</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Termind SFTP Items</string>
			<key>UTTypeIdentifier</key>
			<string>com.akinokaede.termind.sftp-items</string>
		</dict>
	</array>
</dict>
</plist>
