    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind verwendet die Kamera, um Fotos an Ihren Chat anzuhängen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind uses the camera to attach photos to your chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind utilise l’appareil photo pour joindre des photos à votre chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャットに写真を添付するために、Termindがカメラを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind는 채팅에 사진을 첨부하기 위해 카메라를 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind使用相机为聊天添加照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind使用相機為聊天新增照片。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifizieren Sie sich, um Ihre SSH-Schlüssel zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authenticate to use your SSH keys."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifiez-vous pour utiliser vos clés SSH."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH鍵を使用するために認証します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 키를 사용하려면 인증하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过身份验证以使用SSH密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過身分驗證以使用SSH金鑰。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind findet und weckt lokale Server und verbindet sich mit Servern und Modellanbietern in Ihrem lokalen Netzwerk."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind discovers and wakes local servers, and connects to servers and model providers on your local network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind découvre et réveille les serveurs locaux et se connecte aux serveurs et fournisseurs de modèles sur votre réseau local."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termindはローカルサーバの探索と起動を行い、ローカルネットワーク上のサーバやモデルプロバイダに接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind는 로컬 서버를 검색하고 깨우며 로컬 네트워크의 서버 및 모델 제공업체에 연결합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind会发现和唤醒本地服务器，并连接局域网中的服务器和模型提供商。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind會探索和喚醒本機伺服器，並連線至區域網路中的伺服器和模型供應商。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind verwendet das Mikrofon, um Sprache in Ihren Chatentwurf zu transkribieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Termind uses the microphone to transcribe speech into your chat draft."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind utilise le microphone pour transcrire vos paroles dans votre brouillon de chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声をチャットの下書きに文字起こしするために、Termindがマイクを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind는 음성을 채팅 초안의 텍스트로 변환하기 위해 마이크를 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind使用麦克风将语音转写到聊天草稿中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind使用麥克風將語音轉錄到聊天草稿中。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind verwendet die Apple-Spracherkennung, um Ihre Aufnahme in Text umzuwandeln. Je nach Systemeinstellungen und Sprachunterstützung verarbeitet Apple die Audiodaten möglicherweise online."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Termind uses Apple Speech Recognition to turn your recording into text. Depending on system settings and language support, Apple may process the audio online."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind utilise la reconnaissance vocale Apple pour convertir votre enregistrement en texte. Selon les réglages du système et les langues prises en charge, Apple peut traiter l’audio en ligne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TermindはAppleの音声認識を使用して録音をテキストに変換します。システム設定や言語の対応状況によっては、Appleが音声をオンラインで処理する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind는 Apple 음성 인식을 사용하여 녹음을 텍스트로 변환합니다. 시스템 설정 및 언어 지원에 따라 Apple이 오디오를 온라인으로 처리할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind使用Apple语音识别将录音转成文本。根据系统设置和语言支持情况，Apple可能会在线处理音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind使用Apple語音辨識將錄音轉成文字。根據系統設定和語言支援情況，Apple可能會線上處理音訊。"
          }
        }
      }
    },
