    "`%@` can irreversibly destroy data or state." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@` kann Daten oder Zustände unwiderruflich zerstören."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@` peut détruire des données ou un état de façon irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@`はデータや状態を元に戻せない形で破壊する可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@` 명령은 데이터나 상태를 복구할 수 없게 파괴할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@`可以不可逆地破坏数据或状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@`可以不可逆地破壞資料或狀態。"
          }
        }
      }
    },
    "`%@` changes system or file state." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@` ändert den System- oder Dateizustand."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@` modifie l’état du système ou des fichiers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@`はシステムまたはファイルの状態を変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@` 명령은 시스템 또는 파일 상태를 변경합니다."
          }
        },
        "zh-Hans" : {
