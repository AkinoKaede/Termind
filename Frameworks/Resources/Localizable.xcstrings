          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local Network access is denied. Allow Termind to access your local network in System Settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au réseau local est refusé. Autorisez Termind à accéder à votre réseau local dans les réglages système."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルネットワークへのアクセスが拒否されています。システム設定でTermindによるローカルネットワークへのアクセスを許可してください。"
