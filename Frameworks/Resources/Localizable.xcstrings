    "Deny refuses the call. Ask uses the conversation's manual or automatic approval. Approve runs without approval." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“拒绝”会拒绝调用；“询问”使用会话的手动或自动审批；“批准”无需审批即可运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「拒絕」會拒絕呼叫；「詢問」使用工作階段的手動或自動核准；「核准」無需核准即可執行。"
          }
        }
      }
    },
    "Derived from the private key" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
