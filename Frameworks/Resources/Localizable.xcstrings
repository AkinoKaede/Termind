    "Limits open shell, execute, and SFTP channels on each SSH connection. Port forwarding does not use this limit. Changes apply to new channels immediately; active channels continue." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制每条SSH连接上打开的Shell、执行和SFTP通道数。端口转发不受此限制。更改会立即应用于新通道，活动通道将继续运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制每條SSH連線上開啟的Shell、執行和SFTP通道數。連接埠轉送不受此限制。變更會立即套用於新通道，作用中的通道將繼續執行。"
          }
        }
      }
    },
