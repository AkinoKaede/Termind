    "macOS is waiting for you to allow Termind in Login Items." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS wartet darauf, dass Sie Termind in den Anmeldeobjekten erlauben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS attend que vous autorisiez Termind dans les éléments d’ouverture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSは、「ログイン項目」でTermindが許可されるのを待っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 로그인 항목에서 Termind를 허용하기를 기다리고 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS正在等待你在“登录项”中允许Termind。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS正在等待你在「登入項」中允許Termind。"
          }
        }
      }
    },
    "macOS opens Termind when you log in, which also starts the local MCP server if you have it enabled." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS öffnet Termind bei Ihrer Anmeldung. Dabei wird auch der lokale MCP-Server gestartet, sofern er aktiviert ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ouvre Termind à votre connexion, ce qui démarre aussi le serveur MCP local s’il est activé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン時にmacOSがTermindを開きます。ローカルMCPサーバが有効な場合は、同時に起動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인하면 macOS가 Termind를 엽니다. 로컬 MCP 서버가 활성화되어 있으면 함께 시작됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS会在你登录时打开Termind，如果你启用了本地MCP服务器，它也会随之启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS會在你登入時開啟Termind，如果你啟用了本機MCP伺服器，它也會隨之啟動。"
          }
        }
      }
    },
