    "No command is running under that handle. It finished and was already reported, or it was released after going unasked-about for too long." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter dieser Kennung läuft kein Befehl. Er wurde beendet und bereits gemeldet oder nach längerer Zeit ohne Statusabfrage freigegeben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune commande ne s’exécute sous cet identifiant. Elle est terminée et a déjà été signalée, ou son suivi a été libéré après une période trop longue sans demande de statut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このハンドルで実行中のコマンドはありません。すでに終了して結果が報告されたか、長時間照会されなかったため解放されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 핸들로 실행 중인 명령이 없습니다. 이미 종료되어 결과가 보고되었거나, 오랫동안 조회되지 않아 핸들이 해제되었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该句柄下没有正在运行的命令。命令可能已结束并报告结果，或因长时间无人查询而被释放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該控制代碼下沒有正在執行的指令。指令可能已結束並報告結果，或因長時間無人查詢而被釋放。"
          }
        }
      }
    },
