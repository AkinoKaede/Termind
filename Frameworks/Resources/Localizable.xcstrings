    "Click the path to open the same directory in another session. Right-click for more options." : {
      "comment" : "A description of how to use the status bar path.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie auf den Pfad, um dasselbe Verzeichnis in einer anderen Sitzung zu öffnen. Weitere Optionen finden Sie per Rechtsklick."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur le chemin pour ouvrir le même répertoire dans une autre session. Faites un clic droit pour afficher plus d’options."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスをクリックすると、別のセッションで同じディレクトリを開きます。右クリックでその他の操作を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경로를 클릭하면 다른 세션에서 같은 디렉터리를 엽니다. 추가 옵션을 보려면 마우스 오른쪽 버튼을 클릭하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击路径可在另一种会话中打开同一目录。右键查看更多操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點選路徑可在另一種工作階段中開啟同一目錄。右鍵檢視更多操作。"
          }
        }
      }
    },
    "Click the path to open this directory with SFTP. Right-click to copy it or open it in a new workspace." : {
      "comment" : "A description of how to use the status bar to open a directory with SFTP.",
      "extractionState" : "manual",
