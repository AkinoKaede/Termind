    "Some MCP servers have duplicate namespaces and are paused. Edit their namespace IDs to resolve the conflict." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige MCP-Server haben doppelte Namensräume und sind pausiert. Bearbeiten Sie ihre Namensraum-IDs, um den Konflikt zu lösen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains serveurs MCP ont des espaces de noms en double et sont en pause. Modifiez leurs identifiants d’espace de noms pour résoudre le conflit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前空間が重複しているMCPサーバがあるため、一時停止しています。名前空間IDを編集して競合を解消してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 MCP 서버의 네임스페이스가 중복되어 일시 정지되었습니다. 네임스페이스 ID를 편집하여 충돌을 해결하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分MCP服务器的命名空间重复，已暂停使用。请编辑其命名空间ID以解决冲突。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分MCP伺服器的名稱空間重複，已暫停使用。請編輯其名稱空間ID以解決衝突。"
          }
        }
      }
    },
    "Some skills have duplicate names and are paused. Rename them to resolve the conflict." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Skills haben doppelte Namen und sind pausiert. Benennen Sie sie um, um den Konflikt zu lösen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines compétences ont des noms en double et sont en pause. Renommez-les pour résoudre le conflit."
