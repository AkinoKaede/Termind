    "Tool changes are enforced immediately. Existing clients see the new list when they reconnect or list tools again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkzeugänderungen werden sofort wirksam. Bestehende Clients sehen die neue Liste beim erneuten Verbinden oder beim erneuten Auflisten der Werkzeuge."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications des outils s’appliquent immédiatement. Les clients existants voient la nouvelle liste lorsqu’ils se reconnectent ou redemandent la liste des outils."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツールの変更はすぐに適用されます。接続中のクライアントは、再接続またはツール一覧の再取得時に新しい一覧を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도구 변경 사항은 즉시 적용됩니다. 기존 클라이언트는 다시 연결하거나 도구 목록을 다시 가져올 때 새 목록을 확인할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工具更改会立即生效。现有客户端重新连接或再次列出工具时会看到新列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工具更改會立即生效。現有使用者端重新連線或再次列出工具時會看到新清單。"
          }
        }
      }
