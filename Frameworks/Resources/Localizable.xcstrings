    "Stores commands, paths and byte counts; never file bodies, stdin, stdout or stderr." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichert Befehle, Pfade und Byteanzahlen; niemals Dateiinhalte, stdin, stdout oder stderr."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stocke les commandes, les chemins et les nombres d’octets ; jamais le contenu des fichiers, stdin, stdout ou stderr."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンド、パス、バイト数のみを保存します。ファイルの内容、標準入力、標準出力、標準エラー出力は保存しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령, 경로 및 바이트 수만 저장합니다. 파일 내용, 표준 입력, 표준 출력 또는 표준 오류는 저장하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅存储命令、路径和字节数，不存储文件内容、stdin、stdout或stderr。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅儲存指令、路徑和位元組數，不儲存檔案內容、stdin、stdout或stderr。"
          }
        }
      }
