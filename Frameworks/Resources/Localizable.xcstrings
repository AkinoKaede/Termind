    "Allow Termind to send diagnostic data to Google? This includes crash details, app and operating system versions, device information, and diagnostic identifiers." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darf Termind Diagnosedaten an Google senden? Dazu gehören Absturzdetails, App- und Betriebssystemversionen, Geräteinformationen und Diagnosekennungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Termind to send diagnostic data to Google? This includes crash details, app and operating system versions, device information, and diagnostic identifiers."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser Termind à envoyer des données de diagnostic à Google ? Elles comprennent les détails des plantages, les versions de l’app et du système d’exploitation, les informations sur l’appareil et les identifiants de diagnostic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TermindからGoogleへの診断データの送信を許可しますか？クラッシュの詳細、アプリとOSのバージョン、デバイス情報、診断用の識別子が含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termind에서 Google로 진단 데이터를 보내도록 허용할까요? 충돌 세부 정보, 앱 및 운영 체제 버전, 기기 정보와 진단 식별자가 포함됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否允许Termind向Google发送诊断数据？这些数据包含崩溃详情、应用和操作系统版本、设备信息及诊断标识符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否允許Termind向Google傳送診斷資料？這些資料包含當機詳情、App與作業系統版本、裝置資訊及診斷識別碼。"
          }
        }
      }
    },
