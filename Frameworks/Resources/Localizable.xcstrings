    "%@%@\n\nDirectories are deleted recursively. This cannot be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%@\n\nVerzeichnisse werden rekursiv gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%@\n\nLes répertoires sont supprimés récursivement. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%@\n\nディレクトリ内の項目もすべて削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%@\n\n디렉터리 안의 모든 항목도 함께 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
