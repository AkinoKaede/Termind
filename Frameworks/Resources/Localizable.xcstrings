    "You have unsaved changes. Save them before leaving, or discard them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben ungespeicherte Änderungen. Speichern Sie diese vor dem Verlassen oder verwerfen Sie sie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez des modifications non enregistrées. Enregistrez-les avant de quitter ou abandonnez-les."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未保存の変更があります。保存してから移動するか、変更を破棄してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하지 않은 변경 사항이 있습니다. 나가기 전에 저장하거나 변경 사항을 버리세요."
