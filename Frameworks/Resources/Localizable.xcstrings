    "Pipes downloaded content straight into an interpreter — this executes untrusted remote code." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leitet heruntergeladene Inhalte direkt an einen Interpreter weiter — dadurch wird nicht vertrauenswürdiger entfernter Code ausgeführt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmet le contenu téléchargé directement à un interpréteur — cela exécute du code distant non fiable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードした内容を直接インタープリタに渡します。信頼できないリモートコードが実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 내용을 파이프로 인터프리터에 바로 전달합니다. 신뢰할 수 없는 원격 코드가 실행됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将下载内容直接通过管道传给解释器，会执行不可信的远程代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將下載內容直接透過管道傳給直譯器，會執行不可信的遠端程式碼。"
          }
        }
      }
    },
