    "`find -delete` removes every match." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`find -delete` entfernt jeden Treffer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`find -delete` supprime chaque élément trouvé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`find -delete`は一致するすべての項目を削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`find -delete`는 일치하는 모든 항목을 삭제합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`find -delete`会删除每个匹配项。"
