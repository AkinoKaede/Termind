    "Always Ask requires approval for every call. Follow Permissions uses the conversation's permission mode and safety checks." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Immer fragen“ erfordert für jeden Aufruf eine Genehmigung. „Berechtigungen befolgen“ verwendet den Berechtigungsmodus und die Sicherheitsprüfungen der Unterhaltung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Toujours demander » exige une autorisation à chaque appel. « Suivre les autorisations » utilise le mode d’autorisation et les contrôles de sécurité de la conversation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「毎回確認」では、すべての呼び出しに承認が必要です。「権限設定に従う」では、会話の権限モードと安全性チェックを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘항상 확인’은 모든 호출에 승인을 요청합니다. ‘권한 설정 따르기’는 대화의 권한 모드와 안전 검사를 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“始终询问”要求每次调用都由你批准；“跟随权限设置”则使用当前会话的权限模式和安全检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「一律詢問」要求每次呼叫都由你核准；「跟隨權限設定」則使用目前工作階段的權限模式和安全檢查。"
          }
        }
      }
    },
    "Always ask for approval before protected actions" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor geschützten Aktionen immer um Genehmigung bitten"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours demander une autorisation avant les actions protégées"
