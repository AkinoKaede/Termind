    },
    "Recursive or forced delete — no undo, no trash." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekursives oder erzwungenes Löschen — ohne Rückgängig-Funktion oder Papierkorb."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suppression récursive ou forcée — sans annulation ni corbeille."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再帰的または強制的に削除します。取り消しはできず、ゴミ箱にも移動しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재귀적 또는 강제 삭제입니다. 되돌릴 수 없으며 휴지통으로 이동하지도 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "递归或强制删除——无法撤销，也不会移入废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遞迴或強制刪除——無法撤銷，也不會移入廢紙簍。"
          }
        }
      }
    },
