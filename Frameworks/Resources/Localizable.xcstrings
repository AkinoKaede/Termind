    "Identities using these keys will no longer have access to them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identitäten, die diese Schlüssel verwenden, haben keinen Zugriff mehr darauf."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les identités utilisant ces clés n’y auront plus accès."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの鍵を使用する認証情報から、鍵を利用できなくなります。"
