    "Deny refuses the call. Ask uses the conversation's manual or automatic approval. Approve runs without approval." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ablehnen“ verweigert den Aufruf. „Fragen“ verwendet die manuelle oder automatische Genehmigung der Unterhaltung. „Genehmigen“ führt den Aufruf ohne Rückfrage aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Refuser » bloque l’appel. « Demander » utilise l’approbation manuelle ou automatique de la conversation. « Approuver » exécute l’appel sans demander d’autorisation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「拒否」は呼び出しを拒否します。「確認」は会話の手動または自動承認を使用します。「承認」は承認を求めずに実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘거부’는 호출을 거부합니다. ‘확인 요청’은 대화의 수동 또는 자동 승인 방식을 따릅니다. ‘승인’은 승인 요청 없이 실행합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“拒绝”会拒绝调用；“询问”使用会话的手动或自动审批；“批准”无需审批即可运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「拒絕」會拒絕呼叫；「詢問」使用工作階段的手動或自動核准；「核准」無需核准即可執行。"
          }
        }
      }
    },
