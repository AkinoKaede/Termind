    "The server closed the SSH connection while waiting for host-key approval. Retry to connect using the accepted key." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat die SSH-Verbindung während des Wartens auf die Hostschlüssel-Genehmigung geschlossen. Versuchen Sie es erneut, um sich mit dem akzeptierten Schlüssel zu verbinden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a fermé la connexion SSH pendant l’attente de l’autorisation de la clé d’hôte. Réessayez pour vous connecter avec la clé acceptée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト鍵の承認を待つ間に、サーバがSSH接続を閉じました。承認した鍵で接続するには、再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트 키 승인을 기다리는 동안 서버가 SSH 연결을 닫았습니다. 승인된 키로 연결하려면 다시 시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器在等待主机密钥批准时关闭了SSH连接。请使用已接受的密钥重试连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
