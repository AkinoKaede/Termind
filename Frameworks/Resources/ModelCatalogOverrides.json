        "tool_call": true,
        "structured_output": true,
        "modalities": {
          "input": [
            "text",
            "image"
          ],
          "output": [
            "text"
          ]
        },
        "limit": {
          "context": 272000
        },
        "reasoning_options": [
          {
            "type": "effort",
            "values": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          }
        ]
      }
    }
  }
}
